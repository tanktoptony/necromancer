class_name BargeMapOverlay
extends Control

const CELL_SIZE: float = 13.0
const MAP_ORIGIN: Vector2 = Vector2(28.0, 62.0)

var current_room: String = "receiving"
var local_position: Vector2 = Vector2.ZERO
var discovered: Dictionary = {}
var has_hook: bool = false
var gate_open: bool = false
var heart_collected: bool = false

var room_names: Dictionary = {
	"receiving": "Receiving Hold", "forecastle": "Forecastle Passage", "lantern": "Lantern Chapel",
	"gallery": "Quarantine Gallery", "gate": "Rib Gate", "breach": "Hull Breach", "pantry": "Bone Pantry",
	"chain": "Chain Crypt", "shaft": "Winch Shaft", "orlop": "Upper Orlop", "rigging": "Rigging Walk",
	"galley": "Mourning Galley", "captain": "Captain's Ossuary", "deck": "Ossuary Deck"
}

var room_sizes: Dictionary = {
	"receiving": Vector2(768,360), "forecastle": Vector2(768,360), "lantern": Vector2(768,360),
	"gallery": Vector2(1152,648), "gate": Vector2(768,360), "breach": Vector2(960,360), "pantry": Vector2(640,360),
	"chain": Vector2(576,360), "shaft": Vector2(384,648), "orlop": Vector2(1152,360), "rigging": Vector2(960,360),
	"galley": Vector2(768,360), "captain": Vector2(960,360), "deck": Vector2(1152,360)
}

func _ready() -> void:
	custom_minimum_size = Vector2(600.0, 330.0)
	size = custom_minimum_size
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func update_map(room_value: String, position_value: Vector2, discovered_value: Dictionary, hook_value: bool, gate_value: bool, heart_value: bool) -> void:
	current_room = room_value
	local_position = position_value
	discovered = discovered_value
	has_hook = hook_value
	gate_open = gate_value
	heart_collected = heart_value
	queue_redraw()

func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), Color(0.009, 0.01, 0.02, 0.985), true)
	draw_rect(Rect2(Vector2.ZERO, size), Color(0.72, 0.55, 0.31, 0.95), false, 3.0)
	draw_string(ThemeDB.fallback_font, Vector2(22.0, 34.0), "THE PLAGUE BARGE", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18, Color(0.93, 0.73, 0.38))
	draw_string(ThemeDB.fallback_font, Vector2(510.0, 32.0), "M  CLOSE", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 11, Color(0.75, 0.72, 0.68))
	_draw_connections()
	for room_id_value: String in _room_cells().keys():
		if not bool(discovered.get(room_id_value, false)):
			continue
		for cell: Vector2i in _room_cells()[room_id_value]:
			_draw_cell(cell, room_id_value == current_room)
	_draw_markers()
	var current_name: String = str(room_names.get(current_room, "Unknown Room"))
	draw_string(ThemeDB.fallback_font, Vector2(24.0, 278.0), current_name, HORIZONTAL_ALIGNMENT_LEFT, 390.0, 14, Color(0.94, 0.87, 0.77))
	draw_string(ThemeDB.fallback_font, Vector2(24.0, 306.0), "pink: you   violet: Hook   red: heart shard   gold: Rib Gate", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 10, Color(0.7, 0.68, 0.65))

func _draw_cell(cell: Vector2i, is_current: bool) -> void:
	var rect := Rect2(MAP_ORIGIN + Vector2(cell.x, cell.y) * CELL_SIZE, Vector2(CELL_SIZE - 1.5, CELL_SIZE - 1.5))
	var fill := Color(0.12, 0.2, 0.3, 0.98)
	var outline := Color(0.52, 0.68, 0.79, 0.95)
	if is_current:
		fill = Color(0.27, 0.2, 0.39, 0.98)
		outline = Color(0.84, 0.64, 0.95, 1.0)
	draw_rect(rect, fill, true)
	draw_rect(rect, outline, false, 2.0 if is_current else 1.0)

func _draw_connections() -> void:
	var normal := Color(0.56, 0.69, 0.76, 0.95)
	var route: Array = [
		["receiving","forecastle",Vector2i(2,4),Vector2i(3,4)], ["forecastle","lantern",Vector2i(5,4),Vector2i(6,4)],
		["lantern","gallery",Vector2i(8,4),Vector2i(9,4)], ["gallery","gate",Vector2i(13,4),Vector2i(14,4)],
		["gate","breach",Vector2i(15,5),Vector2i(15,6)], ["breach","pantry",Vector2i(19,7),Vector2i(20,7)],
		["pantry","chain",Vector2i(22,7),Vector2i(23,7)], ["chain","shaft",Vector2i(25,7),Vector2i(26,7)],
		["shaft","orlop",Vector2i(27,5),Vector2i(22,4)], ["orlop","rigging",Vector2i(22,4),Vector2i(23,4)],
		["rigging","galley",Vector2i(27,4),Vector2i(28,4)], ["galley","captain",Vector2i(31,4),Vector2i(32,4)],
		["captain","deck",Vector2i(36,4),Vector2i(37,4)]
	]
	for item: Array in route:
		_connect_if(item[0],item[1],item[2],item[3],normal)
	_connect_if("gate","orlop",Vector2i(17,4),Vector2i(18,4),Color(0.82,0.68,0.34,1.0) if gate_open else Color(0.46,0.25,0.2,0.95))

func _connect_if(first: String, second: String, from_cell: Vector2i, to_cell: Vector2i, color: Color) -> void:
	if not bool(discovered.get(first, false)) or not bool(discovered.get(second, false)):
		return
	var from_point := MAP_ORIGIN + (Vector2(float(from_cell.x), float(from_cell.y)) + Vector2(0.5,0.5)) * CELL_SIZE
	var to_point := MAP_ORIGIN + (Vector2(float(to_cell.x), float(to_cell.y)) + Vector2(0.5,0.5)) * CELL_SIZE
	draw_line(from_point, to_point, color, 3.0)

func _draw_markers() -> void:
	var blink: float = 0.72 + 0.28 * absf(sin(Time.get_ticks_msec() * 0.008))
	draw_circle(_player_map_point(), 4.5, Color(0.95,0.38,0.72,blink))
	if bool(discovered.get("chain", false)) and not has_hook:
		_draw_item_marker(Vector2i(24,7), Color(0.72,0.38,0.9,1.0))
	if bool(discovered.get("gallery", false)) and not heart_collected:
		_draw_item_marker(Vector2i(10,1), Color(0.85,0.18,0.3,1.0))
	if bool(discovered.get("gate", false)) or bool(discovered.get("orlop", false)):
		var gate_point := MAP_ORIGIN + Vector2(18.0,4.5) * CELL_SIZE
		draw_rect(Rect2(gate_point - Vector2(3,7), Vector2(6,14)), Color(0.9,0.72,0.3,1.0), not gate_open)

func _player_map_point() -> Vector2:
	var rects := _room_map_rects()
	if not rects.has(current_room):
		return MAP_ORIGIN
	var map_rect: Rect2 = rects[current_room]
	var room_size: Vector2 = room_sizes.get(current_room, Vector2.ONE)
	var tx := clampf(local_position.x / maxf(room_size.x,1.0),0.0,1.0)
	var ty := clampf(local_position.y / maxf(room_size.y,1.0),0.0,1.0)
	return MAP_ORIGIN + Vector2(map_rect.position.x + tx * map_rect.size.x, map_rect.position.y + ty * map_rect.size.y) * CELL_SIZE + Vector2(CELL_SIZE*0.5,CELL_SIZE*0.5)

func _draw_item_marker(cell: Vector2i, color: Color) -> void:
	var point := MAP_ORIGIN + (Vector2(float(cell.x), float(cell.y)) + Vector2(0.5,0.5)) * CELL_SIZE
	draw_circle(point,4.0,color)

func _rect_cells(start_x: int, start_y: int, width: int, height: int) -> Array[Vector2i]:
	var result: Array[Vector2i] = []
	for y: int in range(start_y,start_y+height):
		for x: int in range(start_x,start_x+width):
			result.append(Vector2i(x,y))
	return result

func _room_cells() -> Dictionary:
	return {
		"receiving":_rect_cells(0,3,3,2), "forecastle":_rect_cells(3,3,3,2), "lantern":_rect_cells(6,3,3,2),
		"gallery":_rect_cells(9,0,5,5), "gate":_rect_cells(14,3,4,2), "breach":_rect_cells(15,6,5,2),
		"pantry":_rect_cells(20,6,3,2), "chain":_rect_cells(23,6,3,2), "shaft":_rect_cells(26,5,2,3),
		"orlop":_rect_cells(18,3,5,2), "rigging":_rect_cells(23,3,5,2), "galley":_rect_cells(28,3,4,2),
		"captain":_rect_cells(32,3,5,2), "deck":_rect_cells(37,3,5,2)
	}

func _room_map_rects() -> Dictionary:
	return {
		"receiving":Rect2(0,3,3,2), "forecastle":Rect2(3,3,3,2), "lantern":Rect2(6,3,3,2),
		"gallery":Rect2(9,0,5,5), "gate":Rect2(14,3,4,2), "breach":Rect2(15,6,5,2), "pantry":Rect2(20,6,3,2),
		"chain":Rect2(23,6,3,2), "shaft":Rect2(26,5,2,3), "orlop":Rect2(18,3,5,2), "rigging":Rect2(23,3,5,2),
		"galley":Rect2(28,3,4,2), "captain":Rect2(32,3,5,2), "deck":Rect2(37,3,5,2)
	}
